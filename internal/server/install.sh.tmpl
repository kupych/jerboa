PLIST
	# Ask macOS to pick up the new Quick Action now rather than after a logout.
	/System/Library/CoreServices/pbs -update >/dev/null 2>&1 || true
fi

say ""
say "Jerboa Sync is installed."
if [ "$os" = Darwin ]; then
	say ""
	say "  - Drag a GarageBand project onto 'Jerboa Sync' on your Desktop to back it up."
	say "  - Or right-click a project in Finder -> Quick Actions -> Sync to Jerboa."
	say "  - Double-click Jerboa Sync any time to sync everything it remembers."
	say ""
	say "The first time, macOS asks whether Jerboa Sync may control Terminal. Click OK:"
	say "that's the window that shows the upload progress."
else
	say "Run $BIN inside a project folder, or pass it a project path."
fi
