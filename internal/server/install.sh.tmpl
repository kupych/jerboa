#!/bin/sh
# Jerboa Sync installer. Backs up GarageBand and Reaper projects to your band.
#
#   curl -fsSL {{.ServerURL}}/install.sh | sh
#
# Installs into ~/.jerboa (no sudo) and connects this computer to your band in
# the browser. On a Mac it also adds a "Jerboa Sync" app to drop projects onto,
# and a "Sync to Jerboa" Quick Action in Finder's right-click menu.
set -eu

SERVER='{{.ServerURL}}'
JERBOA_HOME="$HOME/.jerboa"
BIN="$JERBOA_HOME/bin/jerboa-sync"

say() { printf '%s\n' "$*"; }
fail() { printf '\nerror: %s\n' "$*" >&2; exit 1; }

os=$(uname -s)
arch=$(uname -m)
case "$os/$arch" in
	Darwin/arm64) platform=mac ;;
	Darwin/x86_64) platform=mac-intel ;;
	Linux/x86_64) platform=linux ;;
	*) fail "this installer doesn't support $os on $arch yet" ;;
esac

say "Installing Jerboa Sync..."
mkdir -p "$JERBOA_HOME/bin"
# curl doesn't set macOS's quarantine flag, so the tool runs without a
# Gatekeeper warning — unlike a download from the browser.
curl -fsSL "$SERVER/dl/jerboa-sync/$platform" -o "$BIN.download" ||
	fail "couldn't download the sync tool from $SERVER"
chmod +x "$BIN.download"
mv "$BIN.download" "$BIN"

# Re-running the installer to update shouldn't make anyone authorize again.
# Pairing reads the terminal directly: stdin is the pipe this script came from.
if "$BIN" status >/dev/null 2>&1; then
	say "Already connected to your band."
else
	"$BIN" pair --server "$SERVER" </dev/tty ||
		fail "connecting didn't finish — run the installer again to retry"
fi

if [ "$os" = Darwin ]; then
	APP="$HOME/Applications/Jerboa Sync.app"
	mkdir -p "$HOME/Applications"

	# The app is compiled here, on this Mac, so it is never quarantined and needs
	# no code signing. Double-click re-syncs what it remembers; dropping projects
	# on it syncs those and remembers them. It runs in Terminal on purpose, so
	# long uploads show progress instead of looking frozen.
	src="$JERBOA_HOME/Jerboa Sync.applescript"
	cat >"$src" <<'APPLESCRIPT'
on syncCommand()
	return quoted form of (POSIX path of (path to home folder) & ".jerboa/bin/jerboa-sync")
end syncCommand

on runInTerminal(cmd)
	set wasRunning to application "Terminal" is running
	tell application "Terminal"
		activate
		if wasRunning then
			do script cmd
		else
			-- A freshly launched Terminal opens its own window; reuse it rather
			-- than leaving an empty one behind.
			set tries to 0
			repeat while (count of windows) is 0 and tries < 50
				delay 0.1
				set tries to tries + 1
			end repeat
			if (count of windows) > 0 then
				do script cmd in window 1
			else
				do script cmd
			end if
		end if
	end tell
end runInTerminal

on open droppedItems
	set cmd to my syncCommand()
	repeat with f in droppedItems
		set cmd to cmd & " " & quoted form of POSIX path of f
	end repeat
	my runInTerminal(cmd)
end open

on run
	my runInTerminal(my syncCommand())
end run
APPLESCRIPT
	rm -rf "$APP"
	osacompile -o "$APP" "$src" || fail "couldn't build the Jerboa Sync app"

	# Something visible on the Desktop to drop projects onto. It has to be a real
	# Finder alias: dropping onto a symlink launches the app without handing it
	# the dropped files. Written through the bookmark API rather than by
	# scripting Finder, which would add a permission prompt. rm -f (not -rf)
	# clears an old symlink or alias but can never delete a real folder.
	SHORTCUT="$HOME/Desktop/Jerboa Sync"
	rm -f "$SHORTCUT" "$SHORTCUT.app" 2>/dev/null || true
	if ! osascript -l JavaScript - "$APP" "$SHORTCUT" >/dev/null 2>&1 <<'JXA'
function run(argv) {
	ObjC.import('Foundation');
	const err = Ref();
	const target = $.NSURL.fileURLWithPath(argv[0]);
	// 1024 = NSURLBookmarkCreationSuitableForBookmarkFile
	const data = target.bookmarkDataWithOptionsIncludingResourceValuesForKeysRelativeToURLError(1024, $(), $(), err);
	if (data.isNil()) throw new Error('bookmark failed');
	if (!$.NSURL.writeBookmarkDataToURLOptionsError(data, $.NSURL.fileURLWithPath(argv[1]), 0, err)) {
		throw new Error('write failed');
	}
}
JXA
	then
		# Fallback: ask Finder. May show a one-time permission prompt.
		osascript -e 'on run argv' \
			-e 'tell application "Finder" to make alias file to (POSIX file (item 1 of argv) as alias) at (POSIX file (item 2 of argv) as alias)' \
			-e 'end run' "$APP" "$HOME/Desktop" >/dev/null 2>&1 ||
			say "(Couldn't put a shortcut on the Desktop — Jerboa Sync is in your Applications folder.)"
	fi

	# Finder: right-click a project -> Quick Actions -> Sync to Jerboa.
	# It hands the selection to the app above, so there is one code path.
	#
	# Both files below were saved by Automator itself (macOS 26), not written by
	# hand. Don't trim them: a hand-written version missing keys like the
	# action's "arguments" block made Automator refuse to load the workflow, and
	# macOS silently left it out of the menu. If this needs changing, rebuild it
	# in Automator and paste the output back in.
	WF="$HOME/Library/Services/Sync to Jerboa.workflow"
	rm -rf "$WF"
	mkdir -p "$WF/Contents"
	cat >"$WF/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSBackgroundColorName</key>
			<string>background</string>
			<key>NSIconName</key>
			<string>NSActionTemplate</string>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Sync to Jerboa</string>
			</dict>
			<key>NSMessage</key>
			<string>runWorkflowAsService</string>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSApplicationIdentifier</key>
				<string>com.apple.finder</string>
			</dict>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
PLIST
	cat >"$WF/Contents/document.wflow" <<'PLIST'
