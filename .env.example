# Server
JERBOA_ADDR=:8080
JERBOA_BASE_URL=http://localhost:5173
JERBOA_SECRET=change-me-to-a-random-64-char-string

# Database
JERBOA_DB_URL=postgres://jerboa:jerboa@localhost:5432/jerboa?sslmode=disable

# Storage
JERBOA_STORAGE_PATH=./data/uploads

# OIDC (example: Authentik, Keycloak, Google, etc.)
JERBOA_OIDC_ISSUER=https://accounts.google.com
JERBOA_OIDC_CLIENT_ID=your-client-id
JERBOA_OIDC_CLIENT_SECRET=your-client-secret

# Dev-only: allow unauthenticated dev-login when OIDC is unset.
# NEVER set this to true in production.
# JERBOA_DEV_AUTH=false

# Audio processing
JERBOA_FFMPEG_PATH=ffmpeg
JERBOA_FFPROBE_PATH=ffprobe
JERBOA_MAX_UPLOAD_MB=500
JERBOA_WAVEFORM_PEAKS=1800

# Object storage (Hetzner / S3-compatible) — required for file uploads
# JERBOA_S3_ENDPOINT=your-bucket.fsn1.your-objectstorage.com
# JERBOA_S3_BUCKET=your-bucket-name
# JERBOA_S3_REGION=fsn1
# JERBOA_S3_ACCESS_KEY=your-access-key
# JERBOA_S3_SECRET_KEY=your-secret-key
# JERBOA_MAX_FILE_MB=2000
